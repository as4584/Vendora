    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A1A"
      },
      "package": "com.vendora.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Resqlo uses your camera to scan barcodes and labels on your items and to take photos of your inventory.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Resqlo lets you pick photos from your library to attach to inventory items and your profile.",
          "cameraPermission": "Resqlo uses your camera to scan barcodes and labels on your items and to take photos of your inventory.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A1A"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-notifications",
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85f51ce2-35b8-4ba2-b3fe-a4f182a412f9"
      }
    },
    "owner": "lexmakesit",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85f51ce2-35b8-4ba2-b3fe-a4f182a412f9",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
