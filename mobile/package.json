{
  "name": "vendora-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "tunnel:clean": "expo start --tunnel --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.22",
    "expo-background-fetch": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.58.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.4",
    "decode-uri-component": "file:./shims/decode-uri-component",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "image-size": "file:./shims/image-size",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "context/**/*.{ts,tsx}",
      "services/**/*.{ts,tsx}",
      "tasks/**/*.{ts,tsx}",
      "theme/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.js",
      "^@react-native-community/netinfo$": "<rootDir>/__mocks__/netinfo.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/secure-store.js"
    },
    "coverageThreshold": {
      "global": {
        "statements": 92,
        "lines": 93,
        "functions": 94,
        "branches": 80
      }
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "compression": "1.8.2",
    "postcss": "8.5.23",
    "image-size": "$image-size",
    "decode-uri-component": "$decode-uri-component"
  },
  "private": true
}
