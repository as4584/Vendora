# act local runner config
# Uses a slim Ubuntu image (~500 MB) instead of the full GitHub runner (~18 GB)
-P ubuntu-latest=catthehacker/ubuntu:act-22.04
# Load local secrets from .act.secrets (git-ignored)
--secret-file .act.secrets
# Store workflow artifacts locally
--artifact-server-path /tmp/act-artifacts
# Reuse cached images and actions instead of re-downloading on every push,
# so a flaky network can't block the pre-push hook. New images/actions are
# still fetched the first time they're needed.
--pull=false
--action-offline-mode
